{
  "name": "dynamicwf-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "dynamicwf": "./bin/dynamicwf.mjs" },
  "description": "Graph-authored dynamic workflows with a TypeScript + Effect runtime and pi workers",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:spikes": "node --import tsx --test spikes/*.test.ts",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts spikes/*.test.ts",
    "test:repair:core": "node --import tsx --test --test-concurrency=4 tests/repair-core.test.ts tests/adapter-identity.test.ts tests/capabilities.test.ts tests/image-boundary.test.ts tests/request-observation.test.ts tests/native-xai.test.ts tests/execution-failure.test.ts tests/provider-response.test.ts tests/execution-plan.test.ts tests/compiler.test.ts tests/pi-worker.test.ts tests/lineage.test.ts tests/continuation.test.ts tests/task-usage.test.ts tests/graph-view.test.ts tests/graph-view-task-scope.test.ts",
    "test:repair:live": "node --import tsx tests/repair-live.ts",
    "probe:sdk-clean-import": "node scripts/sdk-clean-import.mjs",
    "probe:pi": "node --import tsx spikes/pi-live.ts",
    "probe:workflow": "node --import tsx spikes/workflow-live.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "mcp": "node --import tsx src/mcp.ts",
    "watch": "node --import tsx src/watch.ts",
    "cli": "node --import tsx src/cli.ts",
    "sdk:check": "node scripts/sdk-patches.mjs --check",
    "sdk:apply": "node scripts/sdk-patches.mjs",
    "postinstall": "node scripts/sdk-patches.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "effect": "3.22.1",
    "tsx": "4.20.6",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@effect/workflow": "0.19.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.19.19"
  },
  "exports": {
    "./expressions": "./src/expressions.ts",
    "./graph": "./src/graph.ts",
    "./runtime-contract": "./src/runtime-contract.ts"
  }
}
